# Copy this to `.env` and fill in the values you need.
#
# `.env` is gitignored and must never be committed. Keys are read from the
# environment, never checked in — the brief requires it and so does the CI.
#
# Only the Gate 0 block is needed right now. Everything below it stays blank
# until the stage that uses it.

# ─── Gate 0 · local ad generation ────────────────────────────────────────────
# OpenAI key with access to the images API. Used for gpt-image-2 plate
# generation. This is the one key that blocks Gate 0.
OPENAI_API_KEY=

# Pinned rather than defaulted, so a model change is a visible edit.
OPENAI_IMAGE_MODEL=gpt-image-2

# Where Gate 0 writes plates, HTML and rendered PNGs. Local disk only —
# no bucket exists until stage 3.
GATE0_OUT_DIR=./out/gate0

# Optional. Only needed if the skill is driven headlessly rather than from
# inside Claude Code or Codex, where the subscription already covers it.
# ANTHROPIC_API_KEY=

# ─── Stage 3+ · AWS ──────────────────────────────────────────────────────────
# AWS_REGION=us-east-1
# AWS_PROFILE=

# ─── Stage 6+ · sandboxes ────────────────────────────────────────────────────
# E2B_API_KEY=

# ─── Stage 9 · deploy target ─────────────────────────────────────────────────
# Adstream login is published in the brief. Kept out of this file on purpose:
# an example file that carries real credentials teaches the wrong habit.
# ADSTREAM_URL=
# ADSTREAM_EMAIL=
# ADSTREAM_PASSWORD=

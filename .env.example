# Copy this to `.env` and fill in what the stage you are on needs.
#
# `.env` is gitignored and must never be committed. Keys are read from the
# environment, never checked in — the brief requires it and so does CI.
#
# Only the Gate 0 block is needed right now.

# ─── Gate 0 · local ad generation ────────────────────────────────────────────
# OpenAI key with images API access, for gpt-image-2 plate generation.
# This is the one key that blocks Gate 0.
OPENAI_API_KEY=

# Pinned rather than defaulted, so a model change is a visible edit.
OPENAI_IMAGE_MODEL=gpt-image-2

# Where Gate 0 writes plates, HTML and rendered PNGs. Local disk only.
GATE0_OUT_DIR=./out/gate0

# ─── Stage 2+ · Supabase ─────────────────────────────────────────────────────
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
#
# Used to mint the short-lived per-run JWT that RLS keys off.
# SUPABASE_JWT_SECRET=
#
# ⚠ service_role BYPASSES RLS COMPLETELY.
#   It stays on this machine. It is never placed in a sandbox environment,
#   never written into a hydration file, and never logged. Every isolation
#   guarantee in the design rests on that, which is why it has its own check.
# SUPABASE_SERVICE_ROLE_KEY=

# ─── Stage 5+ · sandboxes ────────────────────────────────────────────────────
# E2B_API_KEY=
#
# Passed into the sandbox so the agent can run. The sandbox environment carries
# these plus its scoped run JWT — and nothing else.
# ANTHROPIC_API_KEY=

# ─── Stage 9 · deploy target ─────────────────────────────────────────────────
# Adstream login is published in the brief. Kept out of this file on purpose:
# an example file that carries real credentials teaches the wrong habit.
# ADSTREAM_URL=
# ADSTREAM_EMAIL=
# ADSTREAM_PASSWORD=

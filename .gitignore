# Secrets — read keys from the environment, never commit them
.env
.env.*
!.env.example
*.pem

# Dependencies
node_modules/
.venv/
__pycache__/

# Terraform — state and locals never go in git
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
.terraform.lock.hcl

# Build output
dist/
build/
.next/

# OS
.DS_Store

# Extracted source packet — the zips are committed, the extraction is not
/packet/

# Downloaded CA bundle, not ours to redistribute
.certs/

# Staged build context for E2B templates, regenerated on every build
sandbox/.staged/
sandbox/toolkit
web/.launch-logs/
web/.staging-kits/
.staging-kits/
